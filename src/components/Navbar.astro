---
import { routes, companyInfo } from "@/data/routes";
import MobileMenu from "@/components/shared/MobileMenu.tsx";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <div class="container-custom">
    <nav
      class="flex items-center justify-between py-4 lg:py-5"
      aria-label="Navegación principal"
    >
      <!-- Logo -->
      <a
        href="/"
        class="relative z-60 flex items-center gap-3"
        aria-label={companyInfo.shortName}
      >
        <img
          src="/horizonLogo.bmp"
          id="logo"
          alt={companyInfo.shortName}
          class="h-10 w-auto md:h-12 object-contain"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-1 lg:flex">
        {
          routes.map((route) => (
            <a
              href={route.href}
              class={`nav-link relative px-4 py-2 text-sm font-medium tracking-wide transition-colors duration-200 text-white/90 hover:text-white [&.scrolled]:text-ink/70 [&.scrolled]:hover:text-ink [&.scrolled]:dark:text-white/80 [&.scrolled]:dark:hover:text-white ${
                currentPath === route.href
                  ? "[&.scrolled]:text-primary text-white"
                  : ""
              }`}
              style={{ fontFamily: "var(--font-heading)" }}
              aria-current={currentPath === route.href ? "page" : undefined}
            >
              {route.label}
              {currentPath === route.href && (
                <span class="absolute bottom-0 left-4 right-4 h-0.5 rounded-full bg-primary dark:bg-secondary" />
              )}
            </a>
          ))
        }
      </div>

      <!-- Desktop CTA & Theme -->
      <div class="hidden items-center gap-4 lg:flex">
        <ThemeToggle />
      </div>

      <!-- Mobile Menu (React Island) -->
      <MobileMenu routes={routes} currentPath={currentPath} client:load />
    </nav>
  </div>
</header>

<!-- Spacer removed because we want the hero to go under the navbar initially -->

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.getElementById("navbar");
    const navLinks = document.querySelectorAll(".nav-link");
    const themeToggle = document.getElementById("theme-toggle");

    if (!navbar) return;

    const updateNavbar = () => {
      const scrollY = window.scrollY;

      if (scrollY > 50) {
        navbar.classList.add(
          "bg-white/95",
          "dark:bg-steel/95",
          "backdrop-blur-md",
          "shadow-[0_1px_3px_rgba(0,0,0,0.05)]",
          "dark:shadow-[0_1px_3px_rgba(0,0,0,0.2)]",
        );

        navLinks.forEach((link) => link.classList.add("scrolled"));
        if (themeToggle) themeToggle.classList.add("scrolled");
      } else {
        navbar.classList.remove(
          "bg-white/95",
          "dark:bg-steel/95",
          "backdrop-blur-md",
          "shadow-[0_1px_3px_rgba(0,0,0,0.05)]",
          "dark:shadow-[0_1px_3px_rgba(0,0,0,0.2)]",
        );

        navLinks.forEach((link) => link.classList.remove("scrolled"));
        if (themeToggle) themeToggle.classList.remove("scrolled");
      }
    };

    // Watch for theme changes to update logo appropriately when scrolled
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          updateNavbar();
        }
      });
    });

    observer.observe(document.documentElement, { attributes: true });

    window.removeEventListener("scroll", updateNavbar);
    window.addEventListener("scroll", updateNavbar, { passive: true });
    updateNavbar();
  });
</script>
