---
import { routes, companyInfo } from "@/data/routes";
import MobileMenu from "@/components/shared/MobileMenu.tsx";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <div class="container-custom">
    <nav
      class="flex items-center justify-between py-4 lg:py-5"
      aria-label="Navegación principal"
    >
      <!-- Logo -->
      <a
        href="/"
        class="relative z-60 flex items-center gap-3"
        aria-label={companyInfo.shortName}
      >
        <!-- Original logo for scrolled state (dark text) -->
        <img
          src="/horizonLogo.bmp"
          id="logo-dark"
          alt={companyInfo.shortName}
          class="h-10 w-auto md:h-12 object-contain hidden dark:hidden"
        />
        <!-- White/Inverted logo for top/dark mode -->
        <img
          src="/horizonLogo.bmp"
          id="logo-light"
          alt={companyInfo.shortName}
          class="h-10 w-auto md:h-12 object-contain brightness-0 invert"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center gap-1 lg:flex">
        {
          routes.map((route) => (
            <a
              href={route.href}
              class={`nav-link relative px-4 py-2 text-sm font-medium tracking-wide transition-colors duration-200 text-white/90 hover:text-white [&.scrolled]:text-ink/70 [&.scrolled]:hover:text-ink [&.scrolled]:dark:text-white/80 [&.scrolled]:dark:hover:text-white ${
                currentPath === route.href
                  ? "[&.scrolled]:text-primary text-white"
                  : ""
              }`}
              style={{ fontFamily: "var(--font-heading)" }}
              aria-current={currentPath === route.href ? "page" : undefined}
            >
              {route.label}
              {currentPath === route.href && (
                <span class="absolute bottom-0 left-4 right-4 h-0.5 rounded-full bg-primary" />
              )}
            </a>
          ))
        }
      </div>

      <!-- Desktop CTA & Theme -->
      <div class="hidden items-center gap-4 lg:flex">
        <ThemeToggle />
      </div>

      <!-- Mobile Menu (React Island) -->
      <MobileMenu routes={routes} currentPath={currentPath} client:load />
    </nav>
  </div>
</header>

<!-- Spacer removed because we want the hero to go under the navbar initially -->

<script>
  document.addEventListener("astro:page-load", () => {
    const navbar = document.getElementById("navbar");
    const navLinks = document.querySelectorAll(".nav-link");
    const themeToggle = document.getElementById("theme-toggle");
    const logoDark = document.getElementById("logo-dark");
    const logoLight = document.getElementById("logo-light");
    
    if (!navbar) return;

    const updateNavbar = () => {
      const scrollY = window.scrollY;

      if (scrollY > 50) {
        navbar.classList.add(
          "bg-white/95",
          "dark:bg-steel/95",
          "backdrop-blur-md",
          "shadow-[0_1px_3px_rgba(0,0,0,0.05)]",
          "dark:shadow-[0_1px_3px_rgba(0,0,0,0.2)]"
        );
        
        navLinks.forEach(link => link.classList.add("scrolled"));
        if (themeToggle) themeToggle.classList.add("scrolled");
        
        // Show dark logo when scrolled in light mode
        if (!document.documentElement.classList.contains('dark')) {
          if (logoDark) logoDark.classList.remove("hidden");
          if (logoLight) logoLight.classList.add("hidden");
        } else {
          // Always show white logo in dark mode
          if (logoDark) logoDark.classList.add("hidden");
          if (logoLight) logoLight.classList.remove("hidden");
        }
      } else {
        navbar.classList.remove(
          "bg-white/95",
          "dark:bg-steel/95",
          "backdrop-blur-md",
          "shadow-[0_1px_3px_rgba(0,0,0,0.05)]",
          "dark:shadow-[0_1px_3px_rgba(0,0,0,0.2)]"
        );
        
        navLinks.forEach(link => link.classList.remove("scrolled"));
        if (themeToggle) themeToggle.classList.remove("scrolled");
        
        // Always show white logo when at top
        if (logoDark) logoDark.classList.add("hidden");
        if (logoLight) logoLight.classList.remove("hidden");
      }
    };

    // Watch for theme changes to update logo appropriately when scrolled
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          updateNavbar();
        }
      });
    });
    
    observer.observe(document.documentElement, { attributes: true });

    window.removeEventListener("scroll", updateNavbar);
    window.addEventListener("scroll", updateNavbar, { passive: true });
    updateNavbar();
  });
</script>
