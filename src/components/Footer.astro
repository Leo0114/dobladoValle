---
import { routes, legalRoutes, companyInfo } from "@/data/routes";
import { servicesData } from "@/data/home";

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-white/70">
  <!-- Main Footer -->
  <div class="container-custom section-padding-sm">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Column 1: Logo & Description -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-5">
          <img
            src="/horizonLogo.bmp"
            alt={companyInfo.shortName}
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-sm leading-relaxed text-white/50 max-w-xs">
          Empresa mexicana del ramo ferretero dedicada al suministro de
          productos para construcción, reparación y mantenimiento.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <!-- WhatsApp -->
          <a
            href={companyInfo.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/50 transition-all duration-200 hover:border-[#25D366] hover:text-[#25D366] hover:bg-[#25D366]/10"
            aria-label="WhatsApp"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
          </a>
          <!-- Phone -->
          <a
            href={companyInfo.phoneHref}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/50 transition-all duration-200 hover:border-primary hover:text-primary hover:bg-primary/10"
            aria-label="Llamar por teléfono"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
          </a>
          <!-- Email -->
          <a
            href={`mailto:${companyInfo.email}`}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-white/50 transition-all duration-200 hover:border-primary hover:text-primary hover:bg-primary/10"
            aria-label="Enviar email"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h4
          class="mb-5 text-xs font-semibold tracking-[0.2em] text-white uppercase"
          style={{ fontFamily: "var(--font-body)" }}
        >
          Navegación
        </h4>
        <ul class="flex flex-col gap-3">
          {
            routes.map((route) => (
              <li>
                <a
                  href={route.href}
                  class="text-sm text-white/50 transition-colors duration-200 hover:text-primary hover:underline underline-offset-4"
                >
                  {route.label}
                </a>
              </li>
            ))
          }
          {
            legalRoutes.map((route) => (
              <li>
                <a
                  href={route.href}
                  class="text-sm text-white/50 transition-colors duration-200 hover:text-primary hover:underline underline-offset-4"
                >
                  {route.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div>
        <h4
          class="mb-5 text-xs font-semibold tracking-[0.2em] text-white uppercase"
          style={{ fontFamily: "var(--font-body)" }}
        >
          Servicios
        </h4>
        <ul class="flex flex-col gap-3">
          {
            servicesData.items.map((service) => (
              <li>
                <span class="text-sm text-white/50">{service.title}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h4
          class="mb-5 text-xs font-semibold tracking-[0.2em] text-white uppercase"
          style={{ fontFamily: "var(--font-body)" }}
        >
          Contacto
        </h4>
        <ul class="flex flex-col gap-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-primary/70 dark:text-secondary-dark"
            >
              <path
                d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
              ></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="text-sm text-white/50">
              Monterrey, Nuevo León, México
            </span>
          </li>
          <li>
            <a
              href={companyInfo.phoneHref}
              class="flex items-center gap-3 text-sm text-white/50 transition-colors hover:text-primary dark:hover:text-secondary-dark"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-primary/70 dark:text-secondary-dark"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              Llámanos
            </a>
          </li>
          <li>
            <a
              href={`mailto:${companyInfo.email}`}
              class="flex items-center gap-3 text-sm text-white/50 transition-colors hover:text-primary dark:hover:text-secondary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-primary/70 dark:text-secondary-dark"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              Envíanos un correo
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/5">
    <div
      class="container-custom flex flex-col items-center justify-between gap-4 py-6 md:flex-row"
    >
      <p class="text-xs text-white/30">
        &copy; {currentYear}
        {companyInfo.name} Made by{" "}
        <a
          class="text-secondary transition-all hover:text-secondary/70"
          href="https://optimmkt.com/"
          rel="noopener noreferrer"
          target="_blank">Optim</a
        >
      </p>
      <div class="flex items-center gap-6">
        {
          legalRoutes.map((route) => (
            <a
              href={route.href}
              class="text-xs text-white/30 transition-colors hover:text-white/60 hover:underline"
            >
              {route.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
