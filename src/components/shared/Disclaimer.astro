---
import { contactInfoData } from "@/data/contact";
---

<section
  class="py-16 md:py-24 relative overflow-hidden bg-bone dark:bg-graphite border-y border-border-light dark:border-white/10"
>
  <!-- Decorative grid -->
  <div
    class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none"
  >
    <div
      style={{
        backgroundImage:
          "linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px)",
        backgroundSize: "40px 40px",
      }}
      class="h-full w-full text-ink dark:text-white"
    >
    </div>
  </div>

  <div class="container-narrow relative z-10 text-center">
    <div class="mx-auto max-w-3xl">
      <!-- Icono de búsqueda -->
      <div
        class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-primary/10 text-primary dark:bg-white/5 dark:text-primary-light"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </div>

      <h2
        class="mb-6 text-balance text-3xl md:text-4xl text-ink dark:text-white"
      >
        ¿No encuentras lo que buscas?
      </h2>

      <p
        class="mb-10 text-base md:text-lg text-concrete dark:text-ash leading-relaxed"
      >
        Nuestro catálogo en línea muestra solo una selección de nuestro
        inventario. Si buscas una herramienta, material o producto en específico
        y no lo ves aquí, <strong>¡comunícate con nosotros!</strong> Seguramente lo
        tenemos en alguna de nuestras sucursales.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {
          contactInfoData.branches.map((branch) => {
            // Extraemos solo el nombre de la sucursal para que el botón no sea tan largo
            const shortName = branch.name.replace("Matriz ", "").replace("Sucursal ", "");
            return (
              <a
                href={branch.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-auto items-center justify-center gap-3 rounded-full bg-primary px-6 py-3.5 text-xs md:text-sm font-semibold uppercase tracking-[0.1em] text-ink transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-light hover:shadow-lg dark:bg-secondary-dark dark:text-white dark:hover:bg-secondary"
                style={{ fontFamily: "var(--font-body)" }}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
                </svg>
                WhatsApp {shortName}
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
