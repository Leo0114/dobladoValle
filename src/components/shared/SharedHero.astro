---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  tag?: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  fadeClass?: string;
}

const { 
  tag, 
  title, 
  description, 
  image, 
  fadeClass = "from-white dark:from-steel/80" 
} = Astro.props;
---

<section class="relative -mt-[72px] lg:-mt-[84px] flex items-center overflow-hidden" style="min-height: 60vh;">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image
      src={image}
      alt={title}
      class="h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-ink/60"></div>
  </div>

  <!-- Content -->
  <div class="container-custom relative z-10 pt-32 pb-16 md:pt-44 md:pb-24">
    <div class="max-w-3xl">
      {tag && (
        <span
          class="mb-4 inline-block text-xs font-semibold tracking-[0.25em] text-primary uppercase"
          style={{ fontFamily: "var(--font-body)" }}
        >
          {tag}
        </span>
      )}
      <h1 class="mb-6 text-3xl md:text-4xl lg:text-5xl font-bold text-white text-balance leading-[1.1]">
        {title}
      </h1>
      {description && (
        <p class="max-w-xl text-base text-white/80 leading-relaxed md:text-lg">
          {description}
        </p>
      )}
    </div>
  </div>

  <div class={`absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t ${fadeClass} to-transparent`}></div>
</section>
