---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { productBrandsData } from "@/data/products";
---

<section class="section-padding bg-bone">
  <div class="container-custom">
    <SectionTitle
      tag={productBrandsData.tag}
      title={productBrandsData.title}
      description={productBrandsData.description}
    />

    <!-- Premium brands -->
    <div class="mb-10">
      <span
        class="mb-6 inline-block text-xs font-medium tracking-[0.2em] text-concrete uppercase"
        style={{ fontFamily: "var(--font-body)" }}
      >
        Marcas Premium
      </span>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          productBrandsData.items
            .filter((b) => b.tier === "premium")
            .map((brand) => (
              <div class="group flex items-center justify-center rounded-2xl border border-primary/10 bg-white px-6 py-10 transition-all duration-300 hover:border-primary/30 hover:shadow-card-hover">
                <span
                  class="text-center text-base font-bold tracking-wide text-ink"
                  style={{ fontFamily: "var(--font-heading)" }}
                >
                  {brand.name}
                </span>
              </div>
            ))
        }
      </div>
    </div>

    <!-- Standard brands -->
    <div>
      <span
        class="mb-6 inline-block text-xs font-medium tracking-[0.2em] text-concrete uppercase"
        style={{ fontFamily: "var(--font-body)" }}
      >
        Más marcas
      </span>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
        {
          productBrandsData.items
            .filter((b) => b.tier === "standard")
            .map((brand) => (
              <div class="group flex items-center justify-center rounded-xl border border-border-light bg-white px-4 py-6 transition-all duration-300 hover:border-primary/20 hover:shadow-card">
                <span
                  class="text-center text-sm font-semibold tracking-wide text-concrete transition-colors duration-300 group-hover:text-ink"
                  style={{ fontFamily: "var(--font-heading)" }}
                >
                  {brand.name}
                </span>
              </div>
            ))
        }
      </div>
    </div>
  </div>
</section>
