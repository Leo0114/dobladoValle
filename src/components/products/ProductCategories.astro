---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { productCategoriesData } from "@/data/products";

// Cargamos la colección para obtener slug e imagen optimizada de cada categoría
const allProducts = await getCollection("productos");

// Mapa: name (en minúsculas, sin acentos) → entry de la colección
const entryByName = new Map(
  allProducts.map((e) => [e.data.name.toLowerCase(), e])
);
---

<section class="section-padding bg-white dark:bg-steel/80">
  <div class="container-custom">
    <SectionTitle
      tag={productCategoriesData.tag}
      title={productCategoriesData.title}
      description={productCategoriesData.description}
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        productCategoriesData.items.map((category) => {
          // Buscamos el entry de content que corresponde a esta categoría
          const entry = entryByName.get(category.name.toLowerCase());
          const href = entry ? `/productos/${entry.slug}` : "/productos";

          return (
            <a
              href={href}
              class="group relative flex flex-col overflow-hidden rounded-2xl bg-bone dark:bg-slate-950/10 transition-all duration-300 hover:-translate-y-1 hover:shadow-elevated"
            >
              {/* Image */}
              <div class="relative aspect-video overflow-hidden">
                {entry ? (
                  <Image
                    src={entry.data.coverImage}
                    alt={category.name}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 50vw"
                    loading="lazy"
                    transition:name={`product-image-${entry.slug}`}
                  />
                ) : (
                  <img
                    src={category.image}
                    alt={category.name}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-ink/60 to-transparent" />

                {/* Icon + Product count badge */}
                <div class="absolute top-3 right-3 flex items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-1 text-[10px] font-medium tracking-wider text-white uppercase backdrop-blur-sm">
                    {category.itemCount}
                  </span>
                </div>
              </div>

              {/* Content */}
              <div class="flex flex-1 flex-col p-5">
                <h3
                  class="mb-1.5 text-base font-semibold text-ink dark:text-white"
                  style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
                  transition:name={entry ? `product-name-${entry.slug}` : undefined}
                >
                  {category.name}
                </h3>
                <p class="flex-1 text-sm leading-relaxed text-concrete dark:text-slate-300">
                  {category.description}
                </p>

                {/* Arrow CTA */}
                <div class="mt-4 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-secondary dark:text-primary opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1" style={{ fontFamily: "var(--font-body)" }}>
                  Ver categoría
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                  </svg>
                </div>
              </div>

              {/* Bottom accent */}
              <div class="absolute bottom-0 left-0 right-0 h-0.5 dark:bg-secondary bg-primary scale-x-0 transition-transform duration-500 origin-left group-hover:scale-x-100" />
            </a>
          );
        })
      }
    </div>
  </div>
</section>
