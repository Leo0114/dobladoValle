---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { productCategoriesData } from "@/data/products";
---

<section class="section-padding bg-white dark:bg-steel/80">
  <div class="container-custom">
    <SectionTitle
      tag={productCategoriesData.tag}
      title={productCategoriesData.title}
      description={productCategoriesData.description}
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-5">
      {
        productCategoriesData.items.map((category) => (
          <div class="group relative overflow-hidden rounded-2xl bg-bone dark:bg-slate-950/10 transition-all duration-300 hover:-translate-y-1 hover:shadow-elevated">
            {/* Image */}
            <div class="relative aspect-16/10 overflow-hidden">
              <img
                src={category.image}
                alt={category.name}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-ink/60 to-transparent" />

              {/* Product count badge */}
              <div class="absolute top-4 right-4">
                <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-[10px] font-medium tracking-wider text-white uppercase backdrop-blur-sm">
                  {category.itemCount}
                </span>
              </div>
            </div>

            {/* Content */}
            <div class="p-6">
              <h3
                class="mb-2 text-base font-semibold text-ink dark:text-white"
                style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
              >
                {category.name}
              </h3>
              <p class="text-sm leading-relaxed text-concrete dark:text-slate-300">
                {category.description}
              </p>
            </div>

            {/* Bottom accent */}
            <div class="absolute bottom-0 left-0 right-0 h-0.5 dark:bg-secondary bg-primary scale-x-0 transition-transform duration-500 origin-left group-hover:scale-x-100" />
          </div>
        ))
      }
    </div>
  </div>
</section>
