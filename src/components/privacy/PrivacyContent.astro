---
import { privacyHeroData, privacySections } from "@/data/privacy";
---

<!-- Hero -->
<section class="relative -mt-[72px] lg:-mt-[84px] overflow-hidden bg-ink">
  <div class="container-custom relative z-10 pt-36 pb-16 md:pt-48 md:pb-20">
    <div class="max-w-3xl">
      <h1 class="text-white text-balance mb-4">
        {privacyHeroData.title}
      </h1>
      <p class="text-sm text-white/40" style={{ fontFamily: "var(--font-body)" }}>
        Última actualización: {privacyHeroData.lastUpdated}
      </p>
    </div>
  </div>
  <!-- Decorative -->
  <div class="absolute top-0 right-0 h-full w-1/3 opacity-5">
    <div
      style={{
        backgroundImage:
          "linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px)",
        backgroundSize: "40px 40px",
      }}
      class="h-full w-full"
    >
    </div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white to-transparent"></div>
</section>

<!-- Content -->
<section class="section-padding bg-white">
  <div class="container-narrow">
    <div class="prose prose-lg max-w-none">
      {
        privacySections.map((section, index) => (
          <div class={`${index > 0 ? "mt-12" : ""}`}>
            <div class="flex items-start gap-4 mb-4">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-xs font-bold text-primary"
                style={{ fontFamily: "var(--font-heading)" }}
              >
                {index + 1}
              </span>
              <h2
                class="text-xl font-semibold text-ink md:text-2xl"
                style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3", margin: "0" }}
              >
                {section.title}
              </h2>
            </div>
            <div class="pl-12">
              <p class="text-base leading-relaxed text-concrete" style={{ margin: "0" }}>
                {section.content}
              </p>
            </div>
            {index < privacySections.length - 1 && (
              <div class="mt-12 border-b border-border-light" />
            )}
          </div>
        ))
      }
    </div>

    <!-- Contact for privacy -->
    <div class="mt-16 rounded-2xl bg-bone p-8 md:p-10 text-center">
      <h3
        class="mb-3 text-lg font-semibold text-ink"
        style={{ fontFamily: "var(--font-heading)" }}
      >
        ¿Tienes preguntas sobre tu privacidad?
      </h3>
      <p class="mb-6 text-sm text-concrete">
        Escríbenos y con gusto te atenderemos.
      </p>
      <a
        href="mailto:contacto@dobladovalle.com"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-xs font-semibold tracking-[0.15em] text-ink uppercase transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-light hover:shadow-lg"
        style={{ fontFamily: "var(--font-body)" }}
      >
        Enviar correo
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
