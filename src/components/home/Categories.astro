---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { categoriesData } from "@/data/home";
---

<section class="section-padding bg-white dark:bg-steel/30">
  <div class="container-custom">
    <SectionTitle
      tag={categoriesData.tag}
      title={categoriesData.title}
      description={categoriesData.description}
    />

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        categoriesData.items.map((category, index) => (
          <a
            href={category.href}
            class="group relative block aspect-[4/3] overflow-hidden rounded-2xl"
          >
            {/* Image */}
            <img
              src={category.image}
              alt={category.name}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />

            {/* Overlay */}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent transition-all duration-300 group-hover:from-ink/90" />

            {/* Content */}
            <div class="absolute inset-0 flex flex-col justify-end p-6">
              <h3
                class="text-lg font-semibold text-white"
                style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
              >
                {category.name}
              </h3>
              <div class="mt-2 flex items-center gap-2 text-white/60 opacity-0 transition-all duration-300 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0">
                <span
                  class="text-xs tracking-wide"
                  style={{ fontFamily: "var(--font-body)" }}
                >
                  Explorar
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
