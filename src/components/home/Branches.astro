---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { branchesData } from "@/data/home";
---

<section class="section-padding bg-white">
  <div class="container-custom">
    <SectionTitle
      tag={branchesData.tag}
      title={branchesData.title}
      description={branchesData.description}
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        branchesData.items.map((branch) => (
          <div
            class="group rounded-2xl border border-border-light bg-bone p-8 transition-all duration-300 hover:border-primary/20 hover:shadow-card-hover md:p-10"
          >
            {/* Header */}
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <h3
                class="text-lg font-semibold text-ink"
                style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
              >
                {branch.name}
              </h3>
            </div>

            {/* Details */}
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-concrete">
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span class="text-sm text-concrete">{branch.address}</span>
              </div>

              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-concrete">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <a
                  href={`tel:${branch.phone.replace(/\s/g, "")}`}
                  class="text-sm text-concrete transition-colors hover:text-primary"
                >
                  {branch.phone}
                </a>
              </div>

              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-concrete">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span class="text-sm text-concrete">{branch.schedule}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
