---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { branchesData } from "@/data/home";
---

<section class="section-padding section-sand">
  <div class="container-custom">
    <div class="text-center mb-16">
      <span
        class="mb-4 inline-block text-xs font-semibold tracking-[0.25em] text-secondary uppercase"
        style={{ fontFamily: "var(--font-body)" }}
      >
        {branchesData.tag}
      </span>
      <h2 class="text-balance text-heading max-w-3xl mx-auto">
        {branchesData.title}
      </h2>
      <p class="mt-4 text-body max-w-2xl mx-auto">
        {branchesData.description}
      </p>
    </div>

    <div class="space-y-24">
      {
        branchesData.items.map((branch, index) => (
          <div class={`flex flex-col gap-10 lg:items-center ${index % 2 !== 0 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}>
            <!-- Info & Images -->
            <div class="w-full lg:w-1/2 flex flex-col gap-6">
              <div class="card-base rounded-2xl p-8 lg:p-10">
                <div class="mb-6 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                      <circle cx="12" cy="10" r="3" />
                    </svg>
                  </div>
                  <h3
                    class="text-2xl font-bold text-heading"
                    style={{ fontFamily: "var(--font-heading)", lineHeight: "1.2" }}
                  >
                    {branch.name}
                  </h3>
                </div>

                <div class="space-y-5">
                  <div class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-concrete dark:text-ash">
                      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span class="text-base text-body">{branch.address}</span>
                  </div>

                  <div class="flex items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-concrete dark:text-ash">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span class="text-base text-body">{branch.schedule}</span>
                  </div>
                  
                  <div class="pt-4 flex gap-4">
                     <a href={branch.phoneHref} class="inline-flex items-center gap-2 rounded-lg border border-border-light bg-bone px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-white hover:border-primary dark:bg-graphite dark:border-white/10 dark:text-white dark:hover:border-primary">
                       Llamar a sucursal
                     </a>
                     <a href={branch.whatsappHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-[#25D366]/10 text-[#25D366] px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-[#25D366] hover:text-white">
                       WhatsApp
                     </a>
                  </div>
                </div>
              </div>
              
              <!-- Images grid -->
              <div class="grid grid-cols-2 gap-4 h-48 sm:h-64">
                {branch.images.map((img) => (
                  <div class="h-full w-full overflow-hidden rounded-2xl">
                     <img src={img} alt={`Instalaciones ${branch.name}`} class="h-full w-full object-cover transition-transform duration-700 hover:scale-110" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>

            <!-- Map -->
            <div class="w-full lg:w-1/2 h-80 sm:h-96 lg:h-[500px]">
              <div class="relative h-full w-full overflow-hidden rounded-2xl border border-border-light dark:border-white/10 bg-bone dark:bg-graphite">
                {branch.mapEmbedUrl ? (
                  <iframe src={branch.mapEmbedUrl} class="h-full w-full" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                ) : (
                  <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
                    <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white dark:bg-steel shadow-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                        <circle cx="12" cy="10" r="3"/>
                      </svg>
                    </div>
                    <h4 class="mb-2 text-lg font-semibold text-heading" style={{ fontFamily: "var(--font-heading)" }}>
                      Ubicación de {branch.name}
                    </h4>
                    <p class="text-sm text-body">Mapa interactivo próximamente</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
