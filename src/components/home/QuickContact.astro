---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { quickContactData } from "@/data/home";

const iconMap: Record<string, string> = {
  whatsapp:
    "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z",
  phone:
    "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z",
  email: "M2 4h20v16H2z M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
};

const fillIcon = ["whatsapp"];
---

<section
  class="section-padding-sm section-bone border-t border-border-light dark:border-white/10"
>
  <div class="container-custom">
    <div class="text-center mb-12">
      <span
        class="mb-3 inline-block text-xs font-semibold tracking-[0.25em] text-secondary uppercase"
        style={{ fontFamily: "var(--font-body)" }}
      >
        {quickContactData.tag}
      </span>
      <h2 class="text-balance text-heading mb-3">
        {quickContactData.title}
      </h2>
      <p class="text-body max-w-2xl mx-auto">
        {quickContactData.description}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 max-w-4xl mx-auto">
      {
        quickContactData.items.map((item) => (
          <a
            href={item.href}
            target={item.icon === "whatsapp" ? "_blank" : undefined}
            rel={item.icon === "whatsapp" ? "noopener noreferrer" : undefined}
            class="group flex flex-col items-center gap-4 rounded-2xl card-base p-8 text-center transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-card-hover"
          >
            <div
              class={`flex h-16 w-16 items-center justify-center rounded-full transition-all duration-300 group-hover:scale-110 ${item.icon === "whatsapp" ? "bg-[#25D366]/10 text-[#25D366] group-hover:bg-[#25D366] group-hover:text-white" : "bg-primary/10 text-primary dark:bg-secondary/10 dark:group-hover:bg-secondary-dark group-hover:bg-primary group-hover:text-white"}`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill={fillIcon.includes(item.icon) ? "currentColor" : "none"}
                stroke={fillIcon.includes(item.icon) ? "none" : "currentColor"}
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={iconMap[item.icon]} />
              </svg>
            </div>
            <div>
              <span
                class="block text-sm font-bold tracking-wider text-heading uppercase mb-1"
                style={{ fontFamily: "var(--font-heading)" }}
              >
                {item.label}
              </span>
              <span class="text-sm font-medium text-body">{item.action}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
