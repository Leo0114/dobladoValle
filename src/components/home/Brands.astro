---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { brandsData } from "@/data/home";
---

<section class="section-padding bg-bone">
  <div class="container-custom">
    <SectionTitle
      tag={brandsData.tag}
      title={brandsData.title}
      description={brandsData.description}
    />

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {
        brandsData.items.map((brand) => (
          <div class="group flex items-center justify-center rounded-xl border border-border-light bg-white px-6 py-8 transition-all duration-300 hover:border-primary/20 hover:shadow-card-hover">
            <span
              class="text-center text-sm font-semibold tracking-wide text-concrete transition-colors duration-300 group-hover:text-ink"
              style={{ fontFamily: "var(--font-heading)" }}
            >
              {brand.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
