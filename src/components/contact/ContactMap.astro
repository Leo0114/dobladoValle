---
import { contactMapData } from "@/data/contact";
---

<section class="section-padding-sm bg-bone">
  <div class="container-custom">
    <div class="text-center mb-10">
      <h2
        class="text-2xl font-semibold text-ink md:text-3xl mb-3"
        style={{ fontFamily: "var(--font-heading)" }}
      >
        {contactMapData.title}
      </h2>
      <p class="text-sm text-concrete">
        {contactMapData.description}
      </p>
    </div>

    <!-- Map Placeholder -->
    <div class="relative overflow-hidden rounded-2xl aspect-[21/9]">
      <img
        src={contactMapData.placeholder}
        alt="Ubicación de Doblado Valle"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-ink/30 flex items-center justify-center">
        <div class="text-center">
          <div class="mb-3 flex h-16 w-16 items-center justify-center rounded-full bg-white/10 backdrop-blur-sm mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-white/80" style={{ fontFamily: "var(--font-heading)" }}>
            Mapa interactivo próximamente
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
