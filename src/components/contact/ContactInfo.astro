---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { contactInfoData } from "@/data/contact";
---

<section class="section-padding bg-white">
  <div class="container-custom">
    <SectionTitle
      tag={contactInfoData.tag}
      title={contactInfoData.title}
    />

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 max-w-4xl mx-auto">
      {
        contactInfoData.branches.map((branch) => (
          <div
            class="group rounded-2xl border border-border-light bg-bone p-8 transition-all duration-300 hover:border-primary/20 hover:shadow-card-hover md:p-10"
          >
            <h3
              class="mb-6 text-xl font-semibold text-ink"
              style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
            >
              {branch.name}
            </h3>

            <div class="space-y-5">
              {/* Address */}
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-primary">
                  <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span class="text-sm text-concrete">{branch.address}</span>
              </div>

              {/* Phone */}
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <a href={`tel:${branch.phone.replace(/\s/g, "")}`} class="text-sm text-concrete transition-colors hover:text-primary">
                  {branch.phone}
                </a>
              </div>

              {/* WhatsApp */}
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-primary">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <a href={`https://wa.me/${branch.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-sm text-concrete transition-colors hover:text-primary">
                  WhatsApp
                </a>
              </div>

              {/* Email */}
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                <a href={`mailto:${branch.email}`} class="text-sm text-concrete transition-colors hover:text-primary">
                  {branch.email}
                </a>
              </div>

              {/* Schedule */}
              <div class="mt-4 rounded-xl bg-white p-4">
                <span class="mb-2 block text-xs font-semibold tracking-[0.1em] text-ink/50 uppercase" style={{ fontFamily: "var(--font-body)" }}>
                  Horario
                </span>
                <div class="space-y-1 text-sm text-concrete">
                  <p>{branch.schedule.weekdays}</p>
                  <p>{branch.schedule.saturday}</p>
                  <p>{branch.schedule.sunday}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
