---
import SectionTitle from "@/components/shared/SectionTitle.astro";
import { contactInfoData } from "@/data/contact";
import { Image } from "astro:assets";
---

<section class="section-padding section-light">
  <div class="container-custom">
    <div class="text-center mb-16">
      <span
        class="mb-4 inline-block text-xs font-semibold tracking-[0.25em] text-secondary uppercase"
        style={{ fontFamily: "var(--font-body)" }}
      >
        {contactInfoData.tag}
      </span>
      <h2 class="text-balance text-heading max-w-3xl mx-auto">
        {contactInfoData.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 max-w-5xl mx-auto">
      {
        contactInfoData.branches.map((branch) => (
          <div class="group overflow-hidden rounded-2xl card-base transition-all duration-300 hover:border-primary/30 hover:shadow-card-hover">
            {/* Branch Image */}
            <div class="h-48 w-full overflow-hidden">
              <Image
                src={branch.image}
                alt={branch.name}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <div class="p-8">
              <h3
                class="mb-6 text-xl font-bold text-heading flex items-center gap-3"
                style={{ fontFamily: "var(--font-heading)", lineHeight: "1.3" }}
              >
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-secondary/10 text-secondary">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                </div>
                {branch.name}
              </h3>

              <div class="space-y-6">
                {/* Address */}
                <div class="flex items-start gap-3">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 shrink-0 text-concrete dark:text-ash"
                  >
                    <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  <span class="text-sm text-body">{branch.address}</span>
                </div>

                {/* Actions Grid */}
                <div class="grid grid-cols-2 gap-3 pt-2">
                  <a
                    href={branch.phoneHref}
                    class="flex items-center justify-center gap-2 rounded-lg border border-border-light bg-bone px-4 py-3 text-sm font-semibold text-ink transition-colors hover:bg-white dark:hover:bg-steel/10 hover:border-primary dark:bg-graphite dark:border-white/10 dark:text-white dark:hover:border-primary"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0 text-primary"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    Llamar
                  </a>

                  <a
                    href={branch.whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-2 rounded-lg bg-[#25D366]/10 px-4 py-3 text-sm font-semibold text-[#25D366] transition-colors hover:bg-[#25D366] hover:text-white"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="shrink-0"
                    >
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                    WhatsApp
                  </a>

                  <a
                    href={`mailto:${branch.email}`}
                    class="col-span-2 flex items-center justify-center gap-2 rounded-lg border dark:hover:bg-steel/10 border-border-light bg-bone px-4 py-3 text-sm font-semibold text-ink transition-colors hover:bg-white hover:border-primary dark:bg-graphite dark:border-white/10 dark:text-white dark:hover:border-primary"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="shrink-0 text-primary"
                    >
                      <rect width="20" height="16" x="2" y="4" rx="2" />
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    Enviar correo
                  </a>
                </div>

                {/* Schedule */}
                <div class="mt-4 rounded-xl card-alt p-5 border border-border-light dark:border-white/5">
                  <div class="flex items-center gap-2 mb-3">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-primary"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span
                      class="block text-xs font-semibold tracking-wider text-heading uppercase"
                      style={{ fontFamily: "var(--font-heading)" }}
                    >
                      Horarios de atención
                    </span>
                  </div>
                  <div class="space-y-1.5 text-sm text-body">
                    <p class="flex justify-between border-b border-border-light dark:border-white/5 pb-1">
                      <span>Lunes a Viernes</span>
                      <span class="font-medium text-heading">
                        8:00 AM - 6:00 PM
                      </span>
                    </p>
                    <p class="flex justify-between border-b border-border-light dark:border-white/5 pb-1">
                      <span>Sábado</span>
                      <span class="font-medium text-heading">
                        8:00 AM - 2:00 PM
                      </span>
                    </p>
                    <p class="flex justify-between text-secondary pt-1">
                      <span>Domingo</span>
                      <span class="font-medium">Cerrado</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
