---
import { contactFormData } from "@/data/contact";
---

<section class="section-padding bg-sand dark:bg-steel/80">
  <div class="container-custom">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-16">
      <!-- Form Column -->
      <div class="lg:col-span-3">
        <div
          class="rounded-2xl bg-white dark:bg-steel/40 p-8 md:p-10"
          style={{ boxShadow: "var(--shadow-elevated)" }}
        >
          <h2
            class="mb-2 text-2xl font-semibold dark:text-white text-ink md:text-3xl"
            style={{ fontFamily: "var(--font-heading)", lineHeight: "1.2" }}
          >
            {contactFormData.title}
          </h2>
          <p
            class="mb-8 text-sm dark:text-white/80 text-concrete leading-relaxed"
          >
            {contactFormData.description}
          </p>

          <form class="space-y-6">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              {
                contactFormData.fields.map((field) => (
                  <div class={field.name === "asunto" ? "sm:col-span-2" : ""}>
                    <label
                      for={field.name}
                      class="mb-2 block text-xs font-semibold tracking-[0.1em] text-ink/70 uppercase dark:text-white/70"
                      style={{ fontFamily: "var(--font-body)" }}
                    >
                      {field.label}
                      {field.required && <span class="text-secondary">*</span>}
                    </label>
                    <input
                      type={field.type}
                      id={field.name}
                      name={field.name}
                      placeholder={field.placeholder}
                      required={field.required}
                      class="w-full rounded-xl border border-border dark:bg-ash/10 dark:text-white bg-bone px-4 py-3.5 text-sm text-ink placeholder:text-ash outline-none transition-all duration-200 focus:border-primary dark:focus:border-secondary focus:ring-2 focus:ring-primary/10"
                      style={{ fontFamily: "var(--font-body)" }}
                    />
                  </div>
                ))
              }
            </div>

            <div>
              <label
                for={contactFormData.messageField.name}
                class="mb-2 block text-xs font-semibold tracking-[0.1em] text-ink/70 uppercase"
                style={{ fontFamily: "var(--font-body)" }}
              >
                {contactFormData.messageField.label}
                {
                  contactFormData.messageField.required && (
                    <span class="text-secondary">*</span>
                  )
                }
              </label>
              <textarea
                id={contactFormData.messageField.name}
                name={contactFormData.messageField.name}
                placeholder={contactFormData.messageField.placeholder}
                required={contactFormData.messageField.required}
                rows={5}
                class="w-full resize-none rounded-xl border border-border dark:bg-ash/10 dark:text-white bg-bone px-4 py-3.5 text-sm text-ink placeholder:text-ash outline-none transition-all duration-200 focus:border-primary focus:ring-2 focus:ring-primary/10"
                style={{ fontFamily: "var(--font-body)" }}></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center gap-3 rounded-full dark:bg-secondary-dark dark:hover:bg-secondary bg-primary px-8 py-4 text-sm font-semibold tracking-[0.15em] text-ink uppercase transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary-light hover:shadow-xl cursor-pointer"
              style={{ fontFamily: "var(--font-body)" }}
            >
              {contactFormData.submitLabel}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Sidebar Info -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        <!-- WhatsApp Card -->
        <a
          href="https://wa.me/5551234567"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-5 rounded-2xl bg-[#25D366]/5 border border-[#25D366]/15 p-6 transition-all duration-300 hover:border-[#25D366]/30 hover:shadow-card-hover"
        >
          <div
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#25D366]/10 text-[#25D366] transition-all duration-300 group-hover:bg-[#25D366] group-hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path>
            </svg>
          </div>
          <div>
            <span
              class="block text-sm font-semibold text-ink"
              style={{ fontFamily: "var(--font-heading)" }}
            >
              WhatsApp
            </span>
            <span class="text-sm text-concrete">Respuesta inmediata</span>
          </div>
        </a>

        <!-- Phone Card -->
        <a
          href="tel:+528126206906"
          class="group flex items-center gap-5 rounded-2xl bg-white dark:bg-steel border border-border-light dark:border-white/10 p-6 transition-all duration-300 hover:border-primary/40 dark:hover:border-secondary/40 hover:shadow-card-hover"
          style={{ boxShadow: "var(--shadow-card)" }}
        >
          <div
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10 dark:bg-secondary/10 dark:text-secondary-dark text-primary transition-all duration-300 group-hover:bg-primary dark:group-hover:bg-secondary-dark group-hover:text-white dark:group-hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
          </div>
          <div>
            <span
              class="block text-sm font-semibold text-heading"
              style={{ fontFamily: "var(--font-heading)" }}
            >
              Teléfono
            </span>
            <span class="text-sm text-body">Habla con un asesor</span>
          </div>
        </a>

        <!-- Email Card -->
        <a
          href="mailto:ventas@dobladovalle.com"
          class="group flex items-center gap-5 rounded-2xl bg-white dark:bg-steel border border-border-light dark:border-white/10 p-6 transition-all duration-300 hover:border-primary/40 dark:hover:border-secondary/40 hover:shadow-card-hover"
          style={{ boxShadow: "var(--shadow-card)" }}
        >
          <div
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10 dark:bg-secondary/10 dark:text-secondary-dark text-primary transition-all duration-300 group-hover:bg-primary dark:group-hover:bg-secondary-dark group-hover:text-white dark:group-hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div>
            <span
              class="block text-sm font-semibold text-heading"
              style={{ fontFamily: "var(--font-heading)" }}
            >
              Email
            </span>
            <span class="text-sm text-body">Envíanos un correo</span>
          </div>
        </a>

        <!-- Schedule info -->
        <div class="rounded-2xl bg-ink p-6">
          <div class="flex items-center gap-3 mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-primary"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span
              class="text-sm font-semibold text-white"
              style={{ fontFamily: "var(--font-heading)" }}
            >
              Horarios
            </span>
          </div>
          <div class="space-y-2 text-sm text-white/50">
            <p>Lunes a viernes: 8:00 - 18:00 h</p>
            <p>Sábado: 8:00 - 14:00 h</p>
            <!-- <p>Domingo: Cerrado</p> -->
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
