---
import MainLayout from "@/layouts/MainLayout.astro";
import SharedHero from "@/components/shared/SharedHero.astro";
import { aboutHeroData } from "@/data/about";
import History from "@/components/about/History.astro";
import Values from "@/components/about/Values.astro";
import Coverage from "@/components/about/Coverage.astro";
---

<MainLayout
  title="Acerca de Nosotros — Doblado Valle"
  description="Conoce la historia, valores y misión de Doblado Valle. Más de 30 años siendo el aliado confiable del ramo ferretero en México."
>
  <SharedHero
    tag={aboutHeroData.tag}
    title={aboutHeroData.title}
    description={aboutHeroData.description}
    image={aboutHeroData.image}
    fadeClass="from-white dark:from-steel/80"
  />
  <History />
  <Values />
  <Coverage />
</MainLayout>
