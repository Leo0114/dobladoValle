---
import MainLayout from "@/layouts/MainLayout.astro";
import SharedHero from "@/components/shared/SharedHero.astro";
import { contactHeroData } from "@/data/contact";
import ContactForm from "@/components/contact/ContactForm.astro";
import ContactInfo from "@/components/contact/ContactInfo.astro";
import ServicesSection from "@/components/contact/ServicesSection.astro";
---

<MainLayout
  title="Contacto — Doblado Valle"
  description="Contáctanos para cotizaciones, asesoría técnica o información sobre nuestros productos y servicios ferreteros."
>
  <SharedHero
    tag={contactHeroData.tag}
    title={contactHeroData.title}
    description={contactHeroData.description}
    image={contactHeroData.image}
    fadeClass="from-sand dark:from-steel/80"
  />
  <!-- <ServicesSection /> -->
  <ContactForm />
  <ContactInfo />
</MainLayout>
