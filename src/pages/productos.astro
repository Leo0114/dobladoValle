---
import MainLayout from "@/layouts/MainLayout.astro";
import SharedHero from "@/components/shared/SharedHero.astro";
import { productsHeroData } from "@/data/products";
import ProductCategories from "@/components/products/ProductCategories.astro";
import ProductBrands from "@/components/products/ProductBrands.astro";
---

<MainLayout
  title="Productos — Doblado Valle"
  description="Explora nuestro catálogo de productos ferreteros: herramientas, pinturas, material eléctrico, plomería, seguridad industrial y más."
>
  <SharedHero
    tag={productsHeroData.tag}
    title={productsHeroData.title}
    description={productsHeroData.description}
    image={productsHeroData.image}
    fadeClass="from-white dark:from-steel/80"
  />
  <ProductCategories />
  <ProductBrands />
</MainLayout>
